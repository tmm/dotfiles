{ config, ... }:
let
  settings = {
    "//" = "Generated by ${config.home.sessionVariables.DOTFILES_HOME}/nix/modules/amp.nix";
    "amp.git.commit.coauthor.enabled" = false;
    "amp.git.commit.ampThread.enabled" = false;
    "amp.defaultVisibility" = {
      "github.com/tmm/dotfiles" = "private";
      "github.com/wevm/abitype" = "private";
      "github.com/wevm/cove" = "private";
      "github.com/wevm/curl.md" = "private";
      "github.com/wevm/ox" = "private";
      "github.com/wevm/viem" = "private";
      "github.com/wevm/wagmi" = "private";
    };
    "amp.showCosts" = true;
  };
in
{
  xdg.configFile."amp/settings.json".text = builtins.toJSON settings;
  xdg.configFile."amp/rex-settings.json".text = builtins.toJSON (
    settings
    // {
      "amp.notifications.enabled" = false;
      "amp.notifications.system.enabled" = false;
    }
  );
}
