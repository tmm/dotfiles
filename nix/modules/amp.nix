{ config, lib, ... }:
let
  browse = "${config.home.homeDirectory}/.local/bin/browse";
  browseSkillDir = "${config.xdg.configHome}/agents/skills/browse";
  # Write through a temp file so a failed run never leaves an empty skill.
  writeBrowseSkill = ''[ -x "$1" ] && "$1" skill > "$2.tmp" && mv "$2.tmp" "$2"'';
  settings = {
    "//" = "Generated by ${config.home.sessionVariables.DOTFILES_HOME}/nix/modules/amp.nix";
    "amp.git.commit.coauthor.enabled" = false;
    "amp.git.commit.ampThread.enabled" = true;
    "amp.defaultVisibility" = {
      "github.com/tmm/dotfiles" = "private";
      "github.com/wevm/abitype" = "private";
      "github.com/wevm/cove" = "private";
      "github.com/wevm/curl.md" = "private";
      "github.com/wevm/ox" = "private";
      "github.com/wevm/viem" = "private";
      "github.com/wevm/wagmi" = "private";
    };
    "amp.showCosts" = true;
  };
in
{
  xdg.configFile."amp/settings.json".text = builtins.toJSON settings;
  xdg.configFile."amp/rex-settings.json".text = builtins.toJSON (
    settings
    // {
      "amp.notifications.enabled" = false;
      "amp.notifications.system.enabled" = false;
    }
  );

  # OpenCode Browse (https://github.com/anomalyco/browse) as an Amp skill, so its MCP tools load only when needed.
  # `browse install` would rewrite the settings above and fish config, so install only the binary (it updates itself).
  xdg.configFile."agents/skills/browse/mcp.json".text = builtins.toJSON {
    browse = {
      command = browse;
      args = [ "mcp" ];
    };
  };
  home.activation.browse = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
    if [ ! -x "${browse}" ]; then
      run env PATH=/usr/bin:/bin:/usr/sbin:/sbin /bin/bash -c \
        'set -o pipefail; curl -fsSL https://opencode.ai/browse/install | bash -s -- --no-setup' \
        || warnEcho "Couldn't install browse; rerun darwin-rebuild when online."
    fi
    if [ -x "${browse}" ]; then
      run /bin/sh -c '${writeBrowseSkill}' _ "${browse}" "${browseSkillDir}/SKILL.md"
    fi
  '';
  # browse updates itself between rebuilds, so refresh its skill daily too.
  launchd.agents.browse-skill = {
    enable = true;
    config = {
      ProgramArguments = [
        "/bin/sh"
        "-c"
        writeBrowseSkill
        "_"
        browse
        "${browseSkillDir}/SKILL.md"
      ];
      RunAtLoad = true;
      StartInterval = 86400;
    };
  };
}
